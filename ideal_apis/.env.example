# Ideal Construction API keys — copy to .env in repo root or ideal_apis/.env
# Free/keyless integrations work without any keys (NPPES, Open-Meteo, USAspending, etc.)

IDEAL_USER_AGENT=IdealConstruction/1.0 (ideal-apis; tampa@idealcgc.com)

# Tier 1 — address & validation
IDEAL_SMARTY_AUTH_ID=
IDEAL_SMARTY_AUTH_TOKEN=
IDEAL_NUMVERIFY_KEY=
IDEAL_VERIPHONE_KEY=
IDEAL_KICKBOX_KEY=

# Tier 1 — leads & permits
IDEAL_YELP_KEY=
IDEAL_DATAGOV_KEY=
IDEAL_SOCRATA_APP_TOKEN=

# Tier 1 — weather
IDEAL_VISUAL_CROSSING_KEY=
IDEAL_STORMGLASS_KEY=

# Tier 1 — government
IDEAL_FASTDOL_KEY=
IDEAL_CENSUS_KEY=

# Tier 2 — documents
IDEAL_OCR_SPACE_KEY=
IDEAL_BUILDPDF_KEY=
IDEAL_PANDADOC_KEY=

# Tier 2 — geo & logistics
IDEAL_GOOGLE_MAPS_KEY=
IDEAL_MAPBOX_KEY=
IDEAL_OPENROUTESERVICE_KEY=
IDEAL_WHEREPARCEL_KEY=
IDEAL_UPS_CLIENT_ID=
IDEAL_UPS_CLIENT_SECRET=

# Tier 2 — property & productivity
IDEAL_ACRELENS_KEY=
IDEAL_OPENCORPORATES_KEY=
IDEAL_DISTRICTAPI_KEY=
IDEAL_CLOCKIFY_KEY=

# Tier 1 — market escalation (free key from fred.stlouisfed.org)
IDEAL_FRED_KEY=

# Tier 1 — compliance (OpenSanctions serves the open dataset keyless; a key raises limits)
IDEAL_OPENSANCTIONS_KEY=

# Tier 1 — air quality
IDEAL_AQICN_KEY=
IDEAL_OPENAQ_KEY=

# Tier 2 — bid package assembly (iLovePDF, free 250 docs/month)
IDEAL_ILOVEPDF_PUBLIC_KEY=
IDEAL_ILOVEPDF_SECRET_KEY=
