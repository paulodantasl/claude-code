# --- Claims mailbox (the dedicated inbox XactAnalysis notifications go to) ---
# For Gmail/Google Workspace: IMAP_HOST=imap.gmail.com and use an App Password,
# never the real account password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=claims@theidealremodeling.com
IMAP_PASSWORD=your_app_password_here
IMAP_FOLDER=INBOX

# Only emails whose From header contains one of these are processed.
# Set empty to process everything (only safe on a truly dedicated inbox).
SENDER_FILTER=xactanalysis.com,xactware.com,verisk.com

# --- JobTread (Settings -> Integrations -> JobTread API) ---
JOBTREAD_GRANT_KEY=your_grant_key_here
JOBTREAD_ORG_ID=your_organization_id_here
# JOBTREAD_ACCOUNT_TYPE=customer

# --- Bridge behavior ---
# POLL_SECONDS=300
# STATE_FILE=state.json
# ARCHIVE_DIR=processed
